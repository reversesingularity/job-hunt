# Adzuna (free key at https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# LLM for honest STAR reordering (optional — falls back to deterministic tailoring)
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# LLM settings
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

# Database
DATABASE_PATH=jobhunt.db

# Fact bank path (user-supplied JSON Resume)
MASTER_CV_PATH=data/master_cv.json

# Auto-apply (Phase 2)
AUTO_APPLY_THRESHOLD=85
REQUIRE_APPROVAL=true

# Stealth scraping (Phase 2)
PROXY_URL=
PROXY_ROTATION=true
